# Enable mod_rewrite
RewriteEngine On

# Custom URL Rewriting Rules
RewriteRule ^(index|contact|keyboard_builder|guide)$ $1.php [NC,L]
RewriteRule ^order/([^/]*)$ order_info.php?order_number=$1 [L]

# Protect the .htaccess file from unauthorized access
<Files .htaccess>
    Order Allow,Deny
    Deny from all
</Files>

# Protect the custom config file (settings-core-7189.php)
<Files settings-core-7189.php>
    Order Deny,Allow
    Deny from all
</Files>

# Disable Directory Listing (prevents users from browsing directories)
Options -Indexes

# Block PHP execution in sensitive directories like /classes
<Directory "/classes">
    <Files "*.php">
        deny from all
    </Files>
</Directory>

<Directory "/includes">
    <Files "*.php">
        deny from all
    </Files>
</Directory>

# Disable XML-RPC (if not needed)
<Files xmlrpc.php>
    Order Deny,Allow
    Deny from all
</Files>

# Block Bad Bots (you can expand the list of user agents as needed)
SetEnvIf User-Agent "BadBot" bad_bot
Deny from env=bad_bot

# Prevent Hotlinking (replace with your actual domain)
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?goldenrod-cheetah-195571.hostingersite.com [NC]
RewriteRule \.(jpg|jpeg|png|gif|bmp|swf|flv)$ - [F]

# Force HTTPS (ensure SSL is set up correctly)
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Disable HTTP methods other than GET and POST
<LimitExcept GET POST>
    Order Deny,Allow
    Deny from all
</LimitExcept>

# Hide server version details for security
ServerSignature Off

# Limit access to sensitive files (can be added for other sensitive files)
<FilesMatch "(^\.|settings-core-7189\.php)">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Additional security headers to protect against XSS and content sniffing
Header set X-XSS-Protection "1; mode=block"
Header set X-Content-Type-Options "nosniff"
Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
Header set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline';"



<IfModule mod_headers.c>
    Header set Content-Security-Policy "
        default-src 'self';
        script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com https://fonts.gstatic.com;
        style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com;
        font-src 'self' https://fonts.gstatic.com;
        img-src 'self' data:;
        connect-src 'self';
    "
</IfModule>

